{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "🔥 ${Member}'s Daily Scrum Update",
      "wrap": true,
      "size": "ExtraLarge",
      "weight": "Bolder",
      "spacing": "Large",
      "color": "Accent"
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "👈 What ${Member} did yesterday",
          "wrap": true,
          "weight": "Bolder",
          "spacing": "Medium",
          "size": "Medium",
          "color": "Good"
        },
        {
          "type": "TextBlock",
          "text": "${Last_Day}",
          "wrap": true,
          "spacing": "Small"
        }
      ],
      "style": "emphasis",
      "bleed": true,
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "👉 What ${Member} is doing today",
          "wrap": true,
          "weight": "Bolder",
          "spacing": "Medium",
          "size": "Medium",
          "color": "Good"
        },
        {
          "type": "TextBlock",
          "text": "${Current_Day}",
          "wrap": true,
          "spacing": "Small"
        }
      ],
      "style": "emphasis",
      "bleed": true,
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "🚧 Blockers",
          "wrap": true,
          "weight": "Bolder",
          "spacing": "Medium",
          "size": "Medium",
          "color": "Attention"
        },
        {
          "type": "TextBlock",
          "text": "${Blockers}",
          "wrap": true,
          "spacing": "Small"
        }
      ],
      "style": "attention",
      "bleed": true,
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "spacing": "Small",
      "horizontalAlignment": "Right",
      "items": [
        {
          "type": "TextBlock",
          "text": "AI-generated content, please verify important details",
          "wrap": true,
          "isSubtle": true,
          "size": "Small",
          "horizontalAlignment": "Right",
          "spacing": "Small"
        },
        {
          "type": "ActionSet",
          "horizontalAlignment": "Right",
          "spacing": "None",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Report issue",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "text": "x-khojicloud-reportIssue scrumUpdate"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
