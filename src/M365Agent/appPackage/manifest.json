{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.21/MicrosoftTeams.schema.json",
    "manifestVersion": "1.21",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "uWorx",
        "websiteUrl": "https://github.com/UWorxInnovationHub/ScrumUpdate",
        "privacyUrl": "https://github.com/UWorxInnovationHub/ScrumUpdate",
        "termsOfUseUrl": "https://github.com/UWorxInnovationHub/ScrumUpdate"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "KhojiX${{APP_NAME_SUFFIX}}",
        "full": "KhojiX${{APP_NAME_SUFFIX}}"
    },
    "description": {
        "short": "KhojiX Bot",
        "full": "KhojiX Bot"
    },
    "accentColor": "#FFFFFF",
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "personal",
                "team",
                "groupChat"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [ "personal", "team", "groupChat" ],
                    "commands": [
                        {
                            "title": "Hi",
                            "description": "Say hi to the bot."
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [
    ],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}