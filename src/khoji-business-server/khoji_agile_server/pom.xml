<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>uk.co.uworx</groupId>
    <artifactId>khoji-baseservice-boot</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>khoji_agile_server</artifactId>
  <packaging>jar</packaging>
  <name>Business Server Main</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <start-class>uk.co.uworx.khoji.agile.KhojiServerApplication</start-class>
    <apache.camel.dep.version>4.8.0</apache.camel.dep.version>
    <springdoc-openapi-starter-webmvc-ui.version>2.6.0</springdoc-openapi-starter-webmvc-ui.version>
    <velocity-engine-core.version>2.3</velocity-engine-core.version>
    <commons-text.version>1.12.0</commons-text.version>
    <liquibase.version>4.30.0</liquibase.version>
    <preliquibase.version>1.6.0</preliquibase.version>
  </properties>
  <dependencies>
    <!--Khoji Security-->
    <dependency>
      <groupId>uk.co.uworx</groupId>
      <artifactId>khoji-security</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>uk.co.uworx</groupId>
          <artifactId>khoji-agile-models</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--Khoji Email-->
    <dependency>
      <groupId>uk.co.uworx</groupId>
      <artifactId>khoji_email</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--Khoji JIRA IMPL-->
    <dependency>
      <groupId>uk.co.uworx</groupId>
      <artifactId>khoji-da-jira-impl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--Spring and other dependencies-->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-quartz</artifactId>
      <version>${apache.camel.dep.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
      <version>${apache.camel.dep.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-core</artifactId>
      <version>${apache.camel.dep.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>${commons-text.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc-openapi-starter-webmvc-ui.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.velocity</groupId>
      <artifactId>velocity-engine-core</artifactId>
      <version>${velocity-engine-core.version}</version>
    </dependency>
    <!--   LIQUIBASE -->
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
      <version>${liquibase.version}</version>
    </dependency>
    <dependency>
      <groupId>net.lbruun.springboot</groupId>
      <artifactId>preliquibase-spring-boot-autoconfigure</artifactId>
      <version>${preliquibase.version}</version>
    </dependency>

  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${springframework.boot.version}</version>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>