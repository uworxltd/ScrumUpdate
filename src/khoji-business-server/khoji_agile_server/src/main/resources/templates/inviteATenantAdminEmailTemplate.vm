#set($support= "${supportEmail}" )
<html>

<head>
</head>

<body style="max-width: 2000px !important;">
    <div style="padding:20px; background: #EBEBEB">
        <div style="border-radius: 10px;
                  background: white;
                  padding: 40px;
                  box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;">
            <div style="display: block;">
                <div style="display: inline-block;">
                    <h2>Welcome to ScrumUpdate!</h2>
                    <p>Congratulations <b>$invitedUser</b> on registering your account with ScrumUpdate, your AI-powered standup assistant that actually remembers your work.</p>
                    <p>Get started now and enhance your efficiency!</p>
                </div>
                <img src="cid:$logoWithoutText" height="60" style="float: right;">
            </div>

            <center>
                <a href="$signUpUrl" target="_blank">
                    <button style="background-color: #12576C;
                     border: 0;
                     padding: 12px;
                     border-radius: 9px;
                     color: white;
                     font-size: .9em;
                     font-weight: bold;
                     margin-top: 15px;
                     font-family: inherit;
                     cursor: pointer;">Explore ScrumUpdate
                    </button>
                </a>
                <div style="color: #666565; margin-top: 10px; font-size: 12px;">
                    <span>Questions? Contact ScrumUpdate Support at</span>
                    <a style="font-weight: bold; color: #15c;" href="mailto:$support">$support</a>
                </div>
            </center>
        </div>
    </div>
</body>

</html>