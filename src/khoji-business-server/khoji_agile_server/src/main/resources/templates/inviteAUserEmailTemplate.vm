#set($support= "${supportEmail}" )
<html>

<head>
</head>

<body style="max-width: 2000px !important;">
    <div style="padding:20px; background: #EBEBEB">
        <div
            style="border-radius: 10px; background: white; padding: 40px; box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;">
            <div style="display: block;">
                <div style="display: inline-block;">
                    <h2>$invitee has invited you to join $appName at ScrumUpdate</h2>
                    <p>Use ScrumUpdate to track and enhance your team's productivity and explore its features.</p>
                </div>
                <img src="cid:$logoWithoutText" height="60" style="float: right;">
            </div>
            <a href="$signUpUrl" target="_blank">
                <button style="background-color: #12576C;
                   border: 0;
                   padding: 12px;
                   border-radius: 9px;
                   color: white;
                   font-size: .9em;
                   font-weight: bold;
                   margin-top: 15px;
                   font-family: inherit;
                   cursor: pointer;">Join ScrumUpdate
                </button>
            </a>
            <center>
                <div style="color: #666565; margin-top: 10px; font-size: 12px;">
                    <span>Questions? Contact ScrumUpdate Support at</span>
                    <a style="font-weight: bold; color: #15c;" href="mailto:$support">$support</a>
                </div>
            </center>
        </div>
    </div>
</body>

</html>