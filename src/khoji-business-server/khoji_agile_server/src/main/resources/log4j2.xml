<?xml version="1.0" encoding="UTF-8"?>
<Configuration
    status="error"
    name="KhojiServerApplication"
>
  <Properties>
    <Property
        name="LOG_FILE"
    >
      logs/kbs-application.log
    </Property>
  </Properties>

  <Appenders>
    <Console
        name="Console"
        target="SYSTEM_OUT"
    >
      <PatternLayout
          pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5p %c{1}:%L - %m%n"
      />
    </Console>

    <RollingFile
        name="File"
        fileName="${LOG_FILE}"
        filePattern="${LOG_FILE}-%d{yyyy-MM-dd}-%i.log"
    >
      <PatternLayout
          pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5p %c{1}:%L - %m%n"
      />
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" />
        <SizeBasedTriggeringPolicy size="2MB" />
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
  </Appenders>

  <Loggers>
    <Logger
        name="uk.co.uworx"
        level="${env:LOG_LEVEL:-DEBUG}"
        additivity="false"
        includeLocation="true"
    >
      <AppenderRef ref="File"/>
    </Logger>

    <Logger
        name="liquibase"
        level="${env:LOG_LEVEL:-DEBUG}"
        additivity="false"
    >
      <AppenderRef ref="File"/>
    </Logger>

    <Logger
        name="net.lbruun.springboot.preliquibase"
        level="${env:LOG_LEVEL:-DEBUG}"
        additivity="false"
    >
      <AppenderRef ref="File"/>
    </Logger>

    <Logger
        name="uk.co.uworx.khoji.agile.KhojiServerApplication"
        level="INFO"
        additivity="false"
    >
      <AppenderRef ref="Console"/>
    </Logger>

    <Root
        level="INFO"
    >
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
