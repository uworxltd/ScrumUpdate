[
  {
    "operation": "shift",
    "spec": {
      "values": {
        "*": {
          "id": "[&1].id",
          "name": "[&1].name",
          "self": "[&1].sprintLink",
          "state": "[&1].status",
          "startDate": "[&1].startDate",
          "endDate": "[&1].endDate",
          "completeDate": "[&1].completionDate",
          "originBoardId": "[&1].originBoardId"
        }
      }
    }
  },
  {
    "operation": "uk.co.uworx.khoji.agile.transform.DanishDateTransform",
    "spec": {
      "values": {
        "startDate": "startDate",
        "endDate": "endDate",
        "completionDate": "completionDate"
      }
    }
  },
  {
    "operation": "uk.co.uworx.khoji.agile.transform.SprintStatusTransform"
  }
]