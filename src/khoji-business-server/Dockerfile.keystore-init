# One-shot keystore init (same lifecycle as unleash-init).
# Creates /run/secrets/khoji-keystore.jck when missing. Key bytes are random;
# passwords come from the environment (Compose local defaults).
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY . .
RUN mvn -pl khoji-agile-models -am -DskipTests -Dmaven.deploy.skip=true package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /src/khoji-agile-models/target/khoji-agile-models-latest.jar /app/khoji-agile-models.jar
ENTRYPOINT ["java", "-cp", "/app/khoji-agile-models.jar", "uk.co.uworx.khoji.agile.internal.helper.KeystoreFiles"]
